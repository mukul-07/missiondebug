#!/bin/sh
# Postinstall: ensure system user + data dirs, enable + start service.
set -e

USER_NAME=missiondebug
DATA_DIR=/var/lib/missiondebug
CONF_DIR=/etc/missiondebug
SESSIONS_DIR="$DATA_DIR/sessions"

case "$1" in
    configure)
        # Same system user as the agent (created by either package, idempotent).
        if ! id "$USER_NAME" >/dev/null 2>&1; then
            adduser --system --group --no-create-home \
                --home "$DATA_DIR" \
                --gecos "MissionDebug" \
                "$USER_NAME"
        fi

        install -d -m 0755 -o "$USER_NAME" -g "$USER_NAME" "$DATA_DIR"
        install -d -m 0755 -o "$USER_NAME" -g "$USER_NAME" "$SESSIONS_DIR"
        install -d -m 0755 "$CONF_DIR"

        # Drop default env file only on first install (don't clobber edits).
        # Template ships in /usr/share (dpkg always restores it); never
        # assume anything under /etc exists — an admin `rm -rf
        # /etc/missiondebug` is preserved across upgrades for conffiles and
        # crashed this script. Last resort: write the defaults inline, so a
        # missing template can never leave the backend env-less (an empty
        # backend.env silently disables the web UI via unset MD_WEB_DIR).
        TEMPLATE=/usr/share/missiondebug/backend.env.default
        if [ ! -f "$CONF_DIR/backend.env" ]; then
            if [ -f "$TEMPLATE" ]; then
                install -m 0644 "$TEMPLATE" "$CONF_DIR/backend.env"
            elif [ -f "$CONF_DIR/backend.env.default" ]; then
                # location used by packages <= 0.8.0
                install -m 0644 "$CONF_DIR/backend.env.default" "$CONF_DIR/backend.env"
            else
                cat > "$CONF_DIR/backend.env" <<'ENVEOF'
# MissionDebug backend environment overrides.
# Edit this file then `sudo systemctl restart missiondebug-backend`.

# Cap total MCAP bytes on disk (0 = unlimited; oldest sessions deleted
# when over). Default conservative for robots with small SSDs.
MD_MAX_DISK_MB=2048

# Path to the built web UI. Set automatically by the missiondebug-web .deb;
# leave empty (or unset) for headless backend installs.
MD_WEB_DIR=/var/lib/missiondebug/web
ENVEOF
                chmod 0644 "$CONF_DIR/backend.env"
            fi
        fi

        if [ -d /run/systemd/system ]; then
            systemctl daemon-reload || true
            systemctl enable missiondebug-backend.service || true
            systemctl start missiondebug-backend.service || true
        fi
        ;;

    abort-upgrade|abort-remove|abort-deconfigure)
        ;;

    *)
        echo "postinst called with unknown argument: $1" >&2
        exit 1
        ;;
esac

exit 0
