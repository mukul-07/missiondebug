#!/bin/sh
# Postinstall: ensure system user + data dirs, enable + start service.
set -e

USER_NAME=missiondebug
DATA_DIR=/var/lib/missiondebug
CONF_DIR=/etc/missiondebug
SESSIONS_DIR="$DATA_DIR/sessions"

case "$1" in
    configure)
        # Same system user as the agent (created by either package, idempotent).
        if ! id "$USER_NAME" >/dev/null 2>&1; then
            adduser --system --group --no-create-home \
                --home "$DATA_DIR" \
                --gecos "MissionDebug" \
                "$USER_NAME"
        fi

        install -d -m 0755 -o "$USER_NAME" -g "$USER_NAME" "$DATA_DIR"
        install -d -m 0755 -o "$USER_NAME" -g "$USER_NAME" "$SESSIONS_DIR"
        install -d -m 0755 "$CONF_DIR"

        # Drop default env file only on first install (don't clobber edits).
        if [ ! -f "$CONF_DIR/backend.env" ]; then
            install -m 0644 "$CONF_DIR/backend.env.default" "$CONF_DIR/backend.env"
        fi

        if [ -d /run/systemd/system ]; then
            systemctl daemon-reload || true
            systemctl enable missiondebug-backend.service || true
            systemctl start missiondebug-backend.service || true
        fi
        ;;

    abort-upgrade|abort-remove|abort-deconfigure)
        ;;

    *)
        echo "postinst called with unknown argument: $1" >&2
        exit 1
        ;;
esac

exit 0
