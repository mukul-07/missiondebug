# MissionDebug backend environment overrides.
# Edit this file then `sudo systemctl restart missiondebug-backend`.

# Cap total MCAP bytes on disk (0 = unlimited; oldest sessions deleted
# when over). Default conservative for robots with small SSDs.
MD_MAX_DISK_MB=2048

# Path to the built web UI. Set automatically by the missiondebug-web .deb;
# leave empty (or unset) for headless backend installs.
MD_WEB_DIR=/var/lib/missiondebug/web
