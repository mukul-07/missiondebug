# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.uv/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Node
node_modules/
dist/
.vite/
*.tsbuildinfo

# TypeScript ad-hoc emit (IDE/editor with isolatedModules sometimes writes
# .js next to .ts/.tsx — the canonical build goes to web/dist via vite).
web/src/**/*.js
!web/src/workers/**/*.js

# Data
sessions/
*.mcap
*.db
*.sqlite
*.sqlite3
# ...but committed fixtures are exempt
!fixtures/*.mcap

# Packaging build artifacts
/build/
/dist/
*.deb

# Editors / OS
.DS_Store
.idea/
.vscode/
*.swp

# Env
.env
.env.local

# Local-only session memory for Claude — not part of the project history.
CLAUDE.md
