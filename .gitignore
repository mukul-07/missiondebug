# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.uv/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Node
node_modules/
dist/
.vite/
*.tsbuildinfo

# TypeScript ad-hoc emit (IDE/editor with isolatedModules sometimes writes
# .js next to .ts/.tsx — the canonical build goes to web/dist via vite).
# Workers were previously un-ignored here, which surfaced stale
# mcap-decoder.js / types.js as untracked noise and risked Vite resolving
# them over the .ts. The source is .ts only; ignore all emitted .js.
web/src/**/*.js

# Data
sessions/
*.mcap
*.db
*.sqlite
*.sqlite3
# ...but committed fixtures are exempt
!fixtures/*.mcap

# Packaging build artifacts
/build/
/dist/
*.deb

# Editors / OS
.DS_Store
.idea/
.vscode/
*.swp

# Env
.env
.env.local

# Local-only session memory for Claude — not part of the project history.
CLAUDE.md

# Local knowledge-graph output (generated, regenerable — not part of the product)
graphify-out/
