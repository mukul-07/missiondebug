<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>missiondebug_capture</name>
  <version>0.1.0</version>
  <description>C++ capture hot path for the MissionDebug agent, exposed to Python via pybind11.</description>
  <maintainer email="noreply@missiondebug.dev">MissionDebug</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>rclcpp</depend>
  <depend>pybind11_vendor</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
